{
  "name": "remotely",
  "version": "0.2.0",
  "type": "module",
  "description": "Desktop app for managing AWS EC2 instances and executing operational runbooks",
  "main": "./out/main/main.cjs",
  "author": "Rizka Sanggar Darmawan <rizka.sanggar@hubbedin.com>",
  "repository": "github:angga2oioi/Remotely",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.677.0",
    "@aws-sdk/client-iam": "^3.677.0",
    "@aws-sdk/client-ssm": "^3.677.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.hubbedin.remotely",
    "productName": "Remotely",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
